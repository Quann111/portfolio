{
  "manifest_version": 3,
  "name": "AutoVideo Gemini Bridge",
  "version": "1.0.0",
  "description": "Cầu nối giữa AutoVideo (127.0.0.1:8765) và Google Gemini Web (gemini.google.com): chia cảnh, kiểm tra kịch bản và viết metadata YouTube.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "debugger"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://gemini.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "AutoVideo Gemini Bridge", "default_popup": "popup.html" }
}
